@startuml
title Диаграмма деятельности — Обработка уведомления (Serverless)

start

:Получение события из Kafka (OrderCreated);
:Парсинг события;
:Определение типа уведомления;

if (Канал уведомления == Email?) then (Да)
    :Формирование email-шаблона;
    :Отправка через Email Adapter (SendGrid);
else (Нет)
    if (Канал уведомления == SMS?) then (Да)
        :Формирование SMS-шаблона;
        :Отправка через SMS Adapter (Twilio);
    else (Нет)
        :Формирование push-шаблона;
        :Отправка через Push Adapter (Firebase);
    endif
endif

if (Отправка успешна?) then (Да)
    :Обновление статуса на SENT;
    :Сохранение в БД;
else (Нет)
    :Обновление статуса на FAILED;
    :Логирование ошибки;
endif

:Логирование результата;

stop

@enduml