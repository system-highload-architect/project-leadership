@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
title Диаграмма компонентов — Order Service (Event‑Driven)

Container(order_service, "Order Service", "Go", "Управление заказами (Event Sourcing + CQRS)")

' === КОМПОНЕНТЫ (Clean Architecture) ===
Component(delivery, "Delivery Layer", "Gin / gRPC", "Обрабатывает HTTP/gRPC-запросы, валидация")

Component(usecase, "Use Cases", "Go", "Бизнес-логика: создание, отмена, изменение статуса заказа")
Component(domain, "Domain", "Go", "Сущности (Order, OrderItem), правила")

' === ИНТЕРФЕЙСЫ (Ports) ===
Component(repo_port, "Repository Port", "Go interface", "Интерфейс доступа к данным (Write + Read)")
Component(event_publisher_port, "Event Publisher Port", "Go interface", "Интерфейс публикации событий")
Component(event_consumer_port, "Event Consumer Port", "Go interface", "Интерфейс подписки на события")

' === АДАПТЕРЫ ===
Component(postgres_adapter, "Postgres Adapter", "Go + pgx", "Реализация репозитория (Write DB, Read DB, Event Store)")
Component(kafka_publisher, "Kafka Publisher", "Go + Sarama", "Публикация событий в Kafka")
Component(kafka_consumer, "Kafka Consumer", "Go + Sarama", "Подписка на события из Kafka")

' === EVENT SOURCING + CQRS ===
Component(event_sourcing, "Event Sourcing", "Go", "Хранит/восстанавливает агрегаты из Event Store")
Component(projection, "Projection Service", "Go", "Строит read-модели из событий (CQRS)")

' === ВНУТРЕННИЕ ЗАВИСИМОСТИ ===
Rel(delivery, usecase, "Вызывает", "зависит")
Rel(usecase, domain, "Использует", "зависит")
Rel(usecase, repo_port, "Вызывает", "зависит (интерфейс)")
Rel(usecase, event_publisher_port, "Вызывает", "зависит (интерфейс)")

Rel(postgres_adapter, repo_port, "Реализует", "реализует интерфейс")
Rel(kafka_publisher, event_publisher_port, "Реализует", "реализует интерфейс")
Rel(kafka_consumer, event_consumer_port, "Реализует", "реализует интерфейс")

Rel(usecase, event_sourcing, "Использует", "зависит")
Rel(event_sourcing, postgres_adapter, "Сохраняет/читает события", "SQL")
Rel(projection, postgres_adapter, "Записывает read-модели", "SQL")
Rel(projection, kafka_consumer, "Подписывается на события", "Kafka")

' === ВНЕШНИЕ СВЯЗИ (только события) ===
' Публикация событий
Rel_D(order_service, kafka, "Публикует события (OrderCreated, OrderPaid, OrderShipped, OrderCancelled)", "Kafka Protocol")

' Подписка на события
Rel_D(kafka, order_service, "Доставляет события (PaymentCompleted, InventoryReserved)", "Kafka Protocol")

' === ПОЯСНЕНИЯ ===
note right of usecase
  Use Cases:
  - CreateOrder (создаёт заказ, публикует OrderCreated)
  - CancelOrder (публикует OrderCancelled, компенсация)
  - UpdateOrderStatus (публикует OrderStatusChanged)
  - GetOrder (читает из Read DB)
  - ListOrders (читает из Read DB)
end note

note right of event_sourcing
  Event Sourcing:
  - Сохраняет события (OrderCreated, OrderPaid, etc.)
  - Восстанавливает агрегаты из событий
  - Использует снапшоты для ускорения
end note

note right of projection
  Projection Service:
  - Строит read-модели (денормализованные таблицы)
  - Обновляется асинхронно через Kafka
  - Поддерживает CQRS
end note

note right of kafka_consumer
  Подписки на события:
  - PaymentCompleted → обновляет статус заказа на PAID
  - InventoryReserved → подтверждает резервирование
  - OrderCancelled → компенсация
end note

@enduml