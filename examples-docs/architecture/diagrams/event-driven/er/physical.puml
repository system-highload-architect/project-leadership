@startuml
title Физическая ER-диаграмма — E‑Commerce Platform (Event‑Driven)

' ===== ORDER SERVICE =====
entity "orders" as orders {
    * id : UUID PRIMARY KEY DEFAULT gen_random_uuid()
    --
    user_id : UUID NOT NULL
    status : VARCHAR(20) NOT NULL DEFAULT 'NEW' CHECK (status IN ('NEW', 'PAID', 'SHIPPED', 'DELIVERED', 'CANCELLED'))
    total_amount : DECIMAL(10,2) NOT NULL DEFAULT 0.00
    shipping_address : TEXT NOT NULL
    discount_code : VARCHAR(50)
    payment_id : UUID
    created_at : TIMESTAMPTZ DEFAULT NOW()
    updated_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_orders_user (user_id)
    INDEX idx_orders_status (status)
    INDEX idx_orders_created (created_at)
}

entity "order_items" as order_items {
    * id : UUID PRIMARY KEY DEFAULT gen_random_uuid()
    --
    order_id : UUID NOT NULL REFERENCES orders(id) ON DELETE CASCADE
    product_id : UUID NOT NULL
    product_name : VARCHAR(255) NOT NULL
    quantity : INTEGER NOT NULL CHECK (quantity > 0)
    price : DECIMAL(10,2) NOT NULL
    total : DECIMAL(10,2) GENERATED ALWAYS AS (quantity * price) STORED
    created_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_order_items_order (order_id)
    INDEX idx_order_items_product (product_id)
}

entity "order_events" as order_events {
    * id : BIGSERIAL PRIMARY KEY
    --
    aggregate_id : UUID NOT NULL
    event_type : VARCHAR(100) NOT NULL
    event_data : JSONB NOT NULL
    event_version : INTEGER NOT NULL DEFAULT 1
    created_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_order_events_aggregate (aggregate_id)
    INDEX idx_order_events_created (created_at)
}

entity "saga_state" as saga_state {
    * id : UUID PRIMARY KEY DEFAULT gen_random_uuid()
    --
    saga_type : VARCHAR(50) NOT NULL
    status : VARCHAR(20) NOT NULL CHECK (status IN ('NEW', 'IN_PROGRESS', 'COMPLETED', 'FAILED', 'CANCELLED'))
    instruction : JSONB NOT NULL
    step_results : JSONB
    created_at : TIMESTAMPTZ DEFAULT NOW()
    updated_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_saga_state_type_status (saga_type, status)
    INDEX idx_saga_state_created (created_at)
}

' ===== PAYMENT SERVICE =====
entity "payments" as payments {
    * id : UUID PRIMARY KEY DEFAULT gen_random_uuid()
    --
    order_id : UUID NOT NULL
    amount : DECIMAL(10,2) NOT NULL CHECK (amount > 0)
    method : VARCHAR(20) NOT NULL CHECK (method IN ('CARD', 'SBP', 'PAYPAL'))
    status : VARCHAR(20) NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'SUCCESS', 'FAILED', 'REFUNDED'))
    transaction_id : VARCHAR(255) UNIQUE
    external_data : JSONB
    created_at : TIMESTAMPTZ DEFAULT NOW()
    updated_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_payments_order (order_id)
    INDEX idx_payments_status (status)
    INDEX idx_payments_transaction (transaction_id)
}

entity "payment_events" as payment_events {
    * id : BIGSERIAL PRIMARY KEY
    --
    aggregate_id : UUID NOT NULL REFERENCES payments(id) ON DELETE CASCADE
    event_type : VARCHAR(100) NOT NULL
    event_data : JSONB NOT NULL
    event_version : INTEGER NOT NULL DEFAULT 1
    created_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_payment_events_aggregate (aggregate_id)
    INDEX idx_payment_events_created (created_at)
}

' ===== INVENTORY SERVICE =====
entity "products" as products {
    * id : UUID PRIMARY KEY DEFAULT gen_random_uuid()
    --
    name : VARCHAR(255) NOT NULL
    description : TEXT
    price : DECIMAL(10,2) NOT NULL CHECK (price >= 0)
    category : VARCHAR(100)
    image_url : TEXT
    created_at : TIMESTAMPTZ DEFAULT NOW()
    updated_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_products_category (category)
    INDEX idx_products_name (name)
}

entity "stock" as stock {
    * id : UUID PRIMARY KEY DEFAULT gen_random_uuid()
    --
    product_id : UUID NOT NULL REFERENCES products(id) ON DELETE CASCADE
    quantity : INTEGER NOT NULL DEFAULT 0 CHECK (quantity >= 0)
    reserved : INTEGER NOT NULL DEFAULT 0 CHECK (reserved >= 0)
    created_at : TIMESTAMPTZ DEFAULT NOW()
    updated_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_stock_product (product_id)
}

entity "reservations" as reservations {
    * id : UUID PRIMARY KEY DEFAULT gen_random_uuid()
    --
    order_id : UUID NOT NULL
    product_id : UUID NOT NULL REFERENCES products(id) ON DELETE CASCADE
    quantity : INTEGER NOT NULL CHECK (quantity > 0)
    status : VARCHAR(20) NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'RELEASED', 'CONFIRMED'))
    created_at : TIMESTAMPTZ DEFAULT NOW()
    updated_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_reservations_order (order_id)
    INDEX idx_reservations_product (product_id)
    INDEX idx_reservations_status (status)
}

entity "inventory_events" as inventory_events {
    * id : BIGSERIAL PRIMARY KEY
    --
    aggregate_id : UUID NOT NULL REFERENCES stock(id) ON DELETE CASCADE
    event_type : VARCHAR(100) NOT NULL
    event_data : JSONB NOT NULL
    event_version : INTEGER NOT NULL DEFAULT 1
    created_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_inventory_events_aggregate (aggregate_id)
    INDEX idx_inventory_events_created (created_at)
}

' ===== USER SERVICE =====
entity "users" as users {
    * id : UUID PRIMARY KEY DEFAULT gen_random_uuid()
    --
    email : VARCHAR(255) NOT NULL UNIQUE
    password_hash : VARCHAR(255) NOT NULL
    name : VARCHAR(100) NOT NULL
    role : VARCHAR(20) NOT NULL DEFAULT 'user' CHECK (role IN ('user', 'manager', 'admin'))
    created_at : TIMESTAMPTZ DEFAULT NOW()
    updated_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_users_email (email)
}

entity "user_events" as user_events {
    * id : BIGSERIAL PRIMARY KEY
    --
    aggregate_id : UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE
    event_type : VARCHAR(100) NOT NULL
    event_data : JSONB NOT NULL
    event_version : INTEGER NOT NULL DEFAULT 1
    created_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_user_events_aggregate (aggregate_id)
    INDEX idx_user_events_created (created_at)
}

' ===== NOTIFICATION SERVICE =====
entity "notifications" as notifications {
    * id : UUID PRIMARY KEY DEFAULT gen_random_uuid()
    --
    user_id : UUID NOT NULL
    type : VARCHAR(50) NOT NULL CHECK (type IN ('ORDER_CONFIRMATION', 'ORDER_CANCELLATION', 'PAYMENT_SUCCESS', 'PAYMENT_FAILED', 'DELIVERY_UPDATE'))
    channel : VARCHAR(20) NOT NULL CHECK (channel IN ('EMAIL', 'SMS', 'PUSH'))
    status : VARCHAR(20) NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'SENT', 'FAILED'))
    content : JSONB NOT NULL
    created_at : TIMESTAMPTZ DEFAULT NOW()
    updated_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_notifications_user (user_id)
    INDEX idx_notifications_status (status)
}

entity "notification_events" as notification_events {
    * id : BIGSERIAL PRIMARY KEY
    --
    aggregate_id : UUID NOT NULL REFERENCES notifications(id) ON DELETE CASCADE
    event_type : VARCHAR(100) NOT NULL
    event_data : JSONB NOT NULL
    event_version : INTEGER NOT NULL DEFAULT 1
    created_at : TIMESTAMPTZ DEFAULT NOW()
    *
    INDEX idx_notification_events_aggregate (aggregate_id)
    INDEX idx_notification_events_created (created_at)
}

' === ВНЕШНИЕ КЛЮЧИ ===
orders ||--|{ order_items : "CASCADE"
orders ||--o{ order_events : "CASCADE"
orders ||--o{ saga_state : "CASCADE"

payments ||--o{ payment_events : "CASCADE"
products ||--o{ stock : "CASCADE"
stock ||--o{ reservations : "CASCADE"
products ||--o{ inventory_events : "CASCADE"
users ||--o{ user_events : "CASCADE"
notifications ||--o{ notification_events : "CASCADE"

@enduml