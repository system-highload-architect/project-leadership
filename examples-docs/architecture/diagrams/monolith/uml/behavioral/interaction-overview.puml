@startuml
title Диаграмма обзора взаимодействия — создание заказа

start
:Покупатель выбирает товары;
:Добавляет в корзину;
:Оформляет заказ;
if (Корзина не пуста?) then (Да)
  :Аутентификация;
  :Ввод адреса доставки;
  :Выбор способа оплаты;
  :Применение купона;
  :Запуск Saga (создание заказа);
  if (Saga успешна?) then (Да)
    :Уведомление клиента;
    stop
  else (Нет)
    :Компенсация (отмена заказа);
    :Уведомление клиента об ошибке;
    stop
  endif
else (Нет)
  :Показать ошибку "Корзина пуста";
  stop
endif

@enduml