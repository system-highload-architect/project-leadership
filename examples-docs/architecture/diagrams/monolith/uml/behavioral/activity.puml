@startuml
title Диаграмма деятельности — создание заказа

start
:Покупатель выбирает товары;
:Добавляет в корзину;
:Оформляет заказ;

if (Аутентифицирован?) then (Да)
  :Проверка корзины;
else (Нет)
  :Аутентификация;
  :Проверка корзины;
endif

:Ввод адреса доставки;
:Выбор способа оплаты;
:Применение купона;

if (Корзина не пуста?) then (Да)
  :Создание заказа (Saga);
  partition "Saga: создание заказа" {
    :Запуск Saga (NEW);
    :Платёж (Saga шаг 1);
    if (Платёж успешен?) then (Да)
      :Резервирование товаров (Saga шаг 2);
      if (Резервирование успешно?) then (Да)
        :Уведомление (Saga шаг 3);
        :Заказ завершён (COMPLETED);
      else (Нет)
        :Компенсация: возврат платежа;
        :Отмена заказа (CANCELLED);
        stop
      endif
    else (Нет)
      :Компенсация: отмена заказа;
      :Отмена заказа (CANCELLED);
      stop
    endif
  }
  :Публикация событий в Kafka;
  :Уведомление клиента;
  stop
else (Нет)
  :Показать ошибку "Корзина пуста";
  stop
endif

@enduml